{
    "name": "laravel/notes-system",
    "description": "Sistema de notas com autenticação e criptografia de conteúdo.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0"
    },
    "require-dev": {
        "laravel/breeze": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
